# ===================================================
# DropCode Backend Environment Configuration Template
# ===================================================

SERVER_PORT=4000

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/dropcode?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=dropcode
DB_PASSWORD=dropcode_secret

# Firebase Authentication & Admin SDK
# Path to service account JSON or leave empty for local development emulation/fallback
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=dropcode-7568e

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Ephemeral Staging Storage
STAGING_LOCAL_DIR=./staging-data
S3_ENABLED=false
S3_BUCKET=dropcode-staging-buffer
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cryptographic Keys (Must be 32+ characters / 256-bit in production)
STAGING_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CODE_PEPPER=dropcode-secure-code-pepper-key-minimum-32-chars-long
IP_ENCRYPTION_KEY=12345678901234567890123456789012

# Razorpay Payments Integration (Test or Production)
RAZORPAY_KEY_ID=rzp_test_dropcode123
RAZORPAY_KEY_SECRET=test_secret_dropcode_456
RAZORPAY_WEBHOOK_SECRET=test_webhook_dropcode_789
